# Kernel config fragment for the unprivileged verifier axis (#143).
#
# Merge into a bpf-next .config and rebuild the guest image so the
# unprivileged rules can be exercised without CAP_BPF:
#
#   cd <bpf-next tree>
#   ./scripts/kconfig/merge_config.sh -m .config <this file>
#   make -j"$(nproc)" bzImage
#   tools/qemu-assets.sh -k arch/x86/boot/bzImage
#
# With this fragment `kernel.unprivileged_bpf_disabled` defaults to 0 and
# the guest agent's `--caps unpriv` mode can load programs with no
# capabilities at all.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=n
# Keep the selftest expectations reachable: no debug-only gates.
CONFIG_DEBUG_INFO_BTF=y
